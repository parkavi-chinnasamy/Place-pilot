# ============================================================
# PlacePilot – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://placepilot_user:your_password@localhost:5432/placepilot_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=placepilot_db
DB_USER=placepilot_user
DB_PASSWORD=your_password

# --- JWT / Auth ---
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://place-pilot-3mft.vercel.app

# --- Frontend ---
# For local development: http://localhost:8000
# For production (Vercel): https://place-pilot-l7bj.onrender.com
REACT_APP_API_URL=https://place-pilot-l7bj.onrender.com
REACT_APP_APP_NAME=PlacePilot

# --- GenAI (Google Gemini) ---
# Get your key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GENAI_PROVIDER=gemini
# Set to "demo" to use fallback recommendations without a real key
GENAI_MODE=demo

# --- ML Model ---
ML_MODEL_PATH=./backend/app/ml/models/random_forest_model.pkl
SHAP_MODE=real
# Set SHAP_MODE=demo if shap library is not available

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx

# --- App Settings ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Admin Default Credentials (change immediately) ---
ADMIN_DEFAULT_EMAIL=admin@placepilot.edu
ADMIN_DEFAULT_PASSWORD=Admin@123!
